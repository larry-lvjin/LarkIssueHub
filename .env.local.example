# 复制为 .env.local 再填值（.env.local 被 .gitignore 忽略）
# 目标应用：每日问题跟踪  https://open.feishu.cn/app/cli_aa8445104379dcb3/baseinfo

FEISHU_APP_ID=cli_aa8445104379dcb3

# 凭证与基础信息 -> App Secret。只填在本机，不要提交、不要发到聊天。
FEISHU_APP_SECRET=

# 目标多维表格所在的 wiki 节点 token（或多维表格 app_token，二选一）
FEISHU_WIKI_TOKEN=

# 已知 app_token 时直接填，跳过知识库解析
FEISHU_APP_TOKEN=
